<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PillManager</AssemblyName>
    <Version>0.2.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Product>PILL 桌面助手</Product>
    <Description>MOONDROP PILL 的非官方 Windows 蓝牙管理工具</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/app.ico" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="PillManager.Licenses.Project.txt" />
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.md" LogicalName="PillManager.Licenses.Notices.txt" />
    <EmbeddedResource Include="../../third-party/CsWinRT-LICENSE.txt" LogicalName="PillManager.Licenses.CsWinRT.txt" />
    <EmbeddedResource Include="../../third-party/Windows-SDK-License.rtf" LogicalName="PillManager.Licenses.WindowsSDK.rtf" />
    <EmbeddedResource Include="../../third-party/DotNet-Runtime-10.0.14.txt" LogicalName="PillManager.Licenses.DotNet.txt" />
    <EmbeddedResource Include="../../third-party/DotNet-Runtime-ThirdPartyNotices-10.0.14.txt" LogicalName="PillManager.Licenses.DotNetNotices.txt" />
    <EmbeddedResource Include="../../third-party/DotNet-Desktop-10.0.14.txt" LogicalName="PillManager.Licenses.Wpf.txt" />
  </ItemGroup>
</Project>

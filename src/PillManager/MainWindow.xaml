<Window x:Class="PillManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PillManager" Title="PILL" Icon="Assets/app.ico" Width="620" Height="660" MinWidth="540" MinHeight="540" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="12" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource PrimaryBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Margin="14,10,14,8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,9">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE7F6;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentBrush}" FontSize="21" Margin="0,0,9,0"/><TextBlock Text="PILL" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="MOONDROP" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,3,0,0"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Border x:Name="PreviewBadge" Visibility="Collapsed" Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,3" Margin="0,0,8,0"><TextBlock Text="界面预览" FontSize="10"/></Border>
        <Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="{DynamicResource SecondaryBrush}" Margin="0,0,6,0"/><TextBlock x:Name="DeviceStatus" Text="未连接" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Width="30" Height="30" Click="Menu_Click" ToolTip="主题与更多操作" AutomationProperties.Name="主题与更多操作"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="15"/>
          <Button.ContextMenu><ContextMenu><MenuItem Header="跟随系统主题" Tag="System" IsCheckable="True" IsChecked="True" Click="Theme_Click"/><MenuItem Header="浅色" Tag="Light" IsCheckable="True" Click="Theme_Click"/><MenuItem Header="深色" Tag="Dark" IsCheckable="True" Click="Theme_Click"/><Separator/><MenuItem Header="Windows 蓝牙设置" Click="BluetoothSettings_Click"/><MenuItem Header="Windows 声音设置" Click="SoundSettings_Click"/><Separator/><MenuItem Header="打开备份目录" Click="OpenBackups_Click"/><Separator/><MenuItem Header="关于与许可证" Click="Licenses_Click"/></ContextMenu></Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="9" Margin="0,0,0,7">
      <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox MinHeight="30" VerticalContentAlignment="Center" x:Name="Devices" ToolTip="选择附近的 PILL 耳机" AutomationProperties.Name="选择耳机"/>
        <Button x:Name="ScanButton" Grid.Column="1" Style="{StaticResource IconButton}" Click="Scan_Click" Margin="6,0,0,0" ToolTip="扫描耳机" AutomationProperties.Name="扫描耳机"><TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="15"/></Button>
        <Button x:Name="ConnectButton" Grid.Column="2" Content="连接设备" Click="Connect_Click" MinWidth="84" Margin="6,0,0,0"/>
        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="?" Click="Help_Click" Margin="6,0,0,0" ToolTip="连接帮助" AutomationProperties.Name="连接帮助"/>
      </Grid>
      <TextBlock x:Name="ConnectionText" Text="将耳机取出充电盒，扫描后连接。" Style="{StaticResource Hint}" Margin="1,6,1,0"/>
      <Border x:Name="HelpPanel" Visibility="Collapsed" Background="{DynamicResource InsetBrush}" CornerRadius="5" Padding="8" Margin="0,7,0,0"><TextBlock Text="先在 Windows 中配对音频。此处连接用于调整耳机设置；若连接失败，请关闭手机上的 MOONDROP App 后重试。关闭窗口会释放管理连接。" Style="{StaticResource Hint}"/></Border>
      </StackPanel>
    </Border>
    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" x:Name="Tabs">
      <TabItem Padding="14,7" Header="耳机"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,5,2,0"><StackPanel>
        <Border Style="{StaticResource Card}"><StackPanel>
          <Grid Margin="0,0,0,12"><TextBlock Text="电量" FontWeight="SemiBold"/><TextBlock x:Name="UpdatedText" Text="等待连接" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"><Border Width="34" Height="34" Background="{DynamicResource InsetBrush}" CornerRadius="7" Margin="0,0,10,0"><TextBlock Text="L" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="左耳" Style="{StaticResource Hint}"/><StackPanel Orientation="Horizontal"><local:BatteryGauge x:Name="LeftGauge" Width="28" Height="15" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="LeftBattery" Text="—" FontSize="18" FontWeight="SemiBold"/></StackPanel></StackPanel></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Width="34" Height="34" Background="{DynamicResource InsetBrush}" CornerRadius="7" Margin="0,0,10,0"><TextBlock Text="R" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="右耳" Style="{StaticResource Hint}"/><StackPanel Orientation="Horizontal"><local:BatteryGauge x:Name="RightGauge" Width="28" Height="15" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="RightBattery" Text="—" FontSize="18" FontWeight="SemiBold"/></StackPanel></StackPanel></StackPanel>
          </Grid>
          <Grid Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="固件 " Style="{StaticResource Hint}"/><TextBlock x:Name="FirmwareText" Text="—" Style="{StaticResource Hint}"/></StackPanel><TextBlock Text="充电盒电量未上报" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel x:Name="AudioPanel">
          <Grid Margin="0,0,0,8"><TextBlock Text="音量与麦克风" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="刷新" Click="AudioRefresh_Click" HorizontalAlignment="Right" MinHeight="25" Padding="8,2"/></Grid>
          <ComboBox MinHeight="30" VerticalContentAlignment="Center" x:Name="AudioDevices" SelectionChanged="AudioDevices_SelectionChanged" AutomationProperties.Name="PILL 音频设备"/>
          <Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><Slider x:Name="AudioVolume" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Windows 音量"/><TextBlock Grid.Column="1" Text="{Binding ElementName=AudioVolume,Path=Value,StringFormat={}{0:F0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
          <Grid><CheckBox x:Name="AudioMute" Content="静音"/><Button Content="应用音量" Click="AudioApply_Click" HorizontalAlignment="Right"/></Grid>
          <TextBlock x:Name="AudioStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
          <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0"><Grid><TextBlock Text="媒体控制" Style="{StaticResource Hint}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Click="Previous_Click" ToolTip="上一曲" AutomationProperties.Name="上一曲" Style="{StaticResource IconButton}"><TextBlock Text="&#xE892;" Style="{StaticResource Glyph}" FontSize="14"/></Button><Button Click="Play_Click" Content="播放 / 暂停" Margin="6,0" ToolTip="控制当前系统媒体会话"/><Button Click="Next_Click" ToolTip="下一曲" AutomationProperties.Name="下一曲" Style="{StaticResource IconButton}"><TextBlock Text="&#xE893;" Style="{StaticResource Glyph}" FontSize="14"/></Button></StackPanel></Grid></Border>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Padding="14,7" Header="均衡器"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,5,2,0"><StackPanel x:Name="EqPanel" IsEnabled="False">
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="声音预设" Style="{StaticResource Heading}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox MinHeight="30" VerticalContentAlignment="Center" x:Name="PresetChoice" AutomationProperties.Name="EQ 预设"/><Button Grid.Column="1" Content="切换预设" Click="PresetApply_Click" Margin="6,0,0,0"/></Grid>
          <TextBlock Text="五段参数 EQ" FontWeight="SemiBold" Margin="0,14,0,8"/>
          <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" RowHeight="28" ColumnHeaderHeight="28" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource StrokeBrush}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryBrush}" RowBackground="{DynamicResource SurfaceBrush}" AlternatingRowBackground="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource StrokeBrush}" x:Name="EqGrid" Height="174" SelectionUnit="Cell" AutomationProperties.Name="均衡器参数">
            <DataGrid.Columns><DataGridTextColumn Header="段" Binding="{Binding Index}" IsReadOnly="True" Width="38"/><DataGridTextColumn Header="频率 / Hz" Binding="{Binding Frequency,UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Q" Binding="{Binding Q,StringFormat=F4,UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="增益 / dB" Binding="{Binding Gain,StringFormat=F2,UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns>
          </DataGrid>
          <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="前级 / dB" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Padding="7,4" VerticalContentAlignment="Center" x:Name="PreGain" Grid.Column="1" AutomationProperties.Name="EQ 前级增益"/><Button Grid.Column="3" Content="应用 EQ" Click="EqApply_Click" Style="{StaticResource Primary}"/></Grid>
          <TextBlock Text="前级 −24～0 dB · 每段 −12～12 dB · 修改后点击应用" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
        </StackPanel></Border>
        <Expander Header="增益档位" Margin="0,0,0,6"><Border Style="{StaticResource Card}" Margin="0,6,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="耳机增益" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox MinHeight="30" VerticalContentAlignment="Center" x:Name="GainChoice" Grid.Column="1" AutomationProperties.Name="增益档位"/><Button Grid.Column="2" Content="应用" Click="GainApply_Click" Margin="6,0,0,0"/></Grid></Border></Expander>
        <Button Content="重新读取" Click="Refresh_Click" HorizontalAlignment="Left"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Padding="14,7" Header="触控"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,5,2,0"><StackPanel x:Name="TouchPanel" IsEnabled="False"><Border Style="{StaticResource Card}"><StackPanel>
        <Grid Margin="0,0,0,10"><TextBlock Text="功能分配" FontWeight="SemiBold"/><CheckBox x:Name="TouchEnabled" Content="启用自定义" HorizontalAlignment="Right"/></Grid>
        <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" RowHeight="26" ColumnHeaderHeight="28" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource StrokeBrush}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryBrush}" RowBackground="{DynamicResource SurfaceBrush}" AlternatingRowBackground="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource StrokeBrush}" x:Name="TouchGrid" Height="270" AutomationProperties.Name="触控功能分配"/>
        <TextBlock Text="双击单元格修改。模式切换手势保留原设置。" Style="{StaticResource Hint}" Margin="0,8,0,10"/>
        <Grid><Button Content="重新读取" Click="Refresh_Click" HorizontalAlignment="Left"/><Button Content="应用触控" Click="TouchApply_Click" Style="{StaticResource Primary}" HorizontalAlignment="Right"/></Grid>
      </StackPanel></Border></StackPanel></ScrollViewer></TabItem>
      <TabItem Padding="14,7" Header="设置"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,5,2,0"><StackPanel>
        <StackPanel x:Name="SettingsPanel" IsEnabled="False">
          <Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="双设备连接" FontWeight="SemiBold"/><Button Content="应用" Click="MultipointApply_Click" HorizontalAlignment="Right" MinHeight="26" Padding="9,2"/></Grid><CheckBox x:Name="MultipointEnabled" Content="允许同时连接两台设备" Margin="0,8,0,0"/><TextBlock x:Name="PeersText" Style="{StaticResource Hint}" Margin="0,7,0,0"/><TextBlock Text="关闭后可能中断另一台设备的音频连接。" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="耳机提示音" FontWeight="SemiBold"/><CheckBox x:Name="VoiceEnabled" Content="启用" HorizontalAlignment="Right"/></Grid>
            <Grid Margin="0,10,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider x:Name="VoiceVolume" Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="提示音音量档位"/><TextBlock Grid.Column="1" Text="{Binding ElementName=VoiceVolume,Path=Value,StringFormat={}{0:F0}/16}" VerticalAlignment="Center" HorizontalAlignment="Center"/><Button Grid.Column="2" Content="应用" Click="VoiceApply_Click"/></Grid><TextBlock x:Name="VoiceReadback" Style="{StaticResource Hint}"/>
          </StackPanel></Border>
        </StackPanel>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="备份与恢复" Style="{StaticResource Heading}"/>
          <WrapPanel><Button Content="导出" Click="Export_Click" Margin="0,0,6,6"/><Button Content="导入预览" Click="Import_Click" Margin="0,0,6,6"/><Button x:Name="RestoreButton" Content="应用导入设置" Click="Restore_Click" IsEnabled="False" Margin="0,0,0,6"/></WrapPanel>
          <TextBlock x:Name="ImportText" Text="每次修改前自动备份。导入后先预览，再应用。" Style="{StaticResource Hint}"/>
        </StackPanel></Border>
        <Expander Header="诊断与版本信息" Margin="0,0,0,6"><Border Style="{StaticResource Card}" Margin="0,6,0,0"><StackPanel>
          <Button Content="保存诊断报告" Click="Diagnostics_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/><TextBox Padding="7,4" VerticalContentAlignment="Center" x:Name="LogBox" IsReadOnly="True" Height="150" FontFamily="Consolas" FontSize="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
          <TextBlock Text="PILL 0.2.1 · 非官方本地工具。诊断报告省略设备标识。游戏模式独立开关及固件升级尚未适配。" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
        </StackPanel></Border></Expander>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Grid Grid.Row="3" Margin="1,7,1,0"><TextBlock x:Name="StatusText" Text="就绪 · 应用设置前自动备份" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,36,0" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/><TextBlock Text="0.2.1" Style="{StaticResource Hint}" HorizontalAlignment="Right" FontSize="10"/></Grid>
  </Grid>
</Window>
